            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "operation": {
        "id_path": [
          "id"
        ],
        "status_path": [
          "status"
        ],
        "poll_capability": "records.get",
        "poll_argument": [
          "path",
          "record_id"
        ]
      }
    }
  ]
}
