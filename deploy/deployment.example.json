{
  "database_path": "/data/agent.sqlite3",
  "settings": {
    "max_model_rounds": 30,
    "max_tool_calls": 80,
    "max_concurrent_runs": 4,
    "max_run_seconds": 86400
  },
  "packs": {
    "records": {"path": "/opt/packs/records/pack.json"}
  },
  "users": {
    "operator": {
      "api_key_env": "AGENT_OPERATOR_API_KEY",
      "packs": {
        "records": {
          "environment": {
            "RECORDS_API_URL": "RECORDS_API_URL",
            "RECORDS_API_TOKEN": "RECORDS_API_TOKEN"
          },
          "granted_capabilities": ["records.get"],
          "approval_capabilities": [],
          "allow_model_data": true
        }
      }
    }
  }
}
